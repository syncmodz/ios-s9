--- a/libkern/conf/Makefile.template	2026-10-31 19:09:32
+++ b/libkern/conf/Makefile.template	2026-10-31 19:54:52
@@ -19,6 +19,51 @@
 CFLAGS+= -include meta_features.h -DLIBKERN_KERNEL_PRIVATE -DOSALLOCDEBUG=1
 SFLAGS+= -include meta_features.h
 
+ifeq ($(CURRENT_MACHINE_CONFIG),SWEET)
+SWEET_AES_ROOT = $(SRCROOT)/libkern/crypto/sweet_bearssl
+SWEET_AES_INC = -I$(SWEET_AES_ROOT)/inc -I$(SWEET_AES_ROOT)/src
+sweet_aes.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_aes_ct.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_aes_ct_enc.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_aes_ct_dec.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_aes_ct_cbcenc.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_aes_ct_cbcdec.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_aes.o_CFLAGS_ADD += -mgeneral-regs-only
+sweet_aes_ct.o_CFLAGS_ADD += -mgeneral-regs-only
+sweet_aes_ct_enc.o_CFLAGS_ADD += -mgeneral-regs-only
+sweet_aes_ct_dec.o_CFLAGS_ADD += -mgeneral-regs-only
+sweet_aes_ct_cbcenc.o_CFLAGS_ADD += -mgeneral-regs-only
+sweet_aes_ct_cbcdec.o_CFLAGS_ADD += -mgeneral-regs-only
+corecrypto_aes.o_CFLAGS_ADD += -mgeneral-regs-only
+# BearSSL MD5 behind the legacy MD5Init/Update/Final API (corecrypto_md5.c).
+sweet_md5.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_dec32le.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_enc32le.o_INCFLAGS = $(SWEET_AES_INC)
+corecrypto_md5.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_md5.o_CFLAGS_ADD += -mgeneral-regs-only
+sweet_dec32le.o_CFLAGS_ADD += -mgeneral-regs-only
+sweet_enc32le.o_CFLAGS_ADD += -mgeneral-regs-only
+corecrypto_md5.o_CFLAGS_ADD += -mgeneral-regs-only
+# BearSSL SHA-1 behind the legacy SHA1Init/Update/Final API (corecrypto_sha1.c).
+sweet_sha1.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_dec32be.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_enc32be.o_INCFLAGS = $(SWEET_AES_INC)
+corecrypto_sha1.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_sha1.o_CFLAGS_ADD += -mgeneral-regs-only
+sweet_dec32be.o_CFLAGS_ADD += -mgeneral-regs-only
+sweet_enc32be.o_CFLAGS_ADD += -mgeneral-regs-only
+corecrypto_sha1.o_CFLAGS_ADD += -mgeneral-regs-only
+# BearSSL SHA-384/512 for SHA384_*/SHA512_* (corecrypto_sha2.c).
+sweet_sha2big.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_dec64be.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_enc64be.o_INCFLAGS = $(SWEET_AES_INC)
+corecrypto_sha2.o_INCFLAGS = $(SWEET_AES_INC)
+sweet_sha2big.o_CFLAGS_ADD += -mgeneral-regs-only
+sweet_dec64be.o_CFLAGS_ADD += -mgeneral-regs-only
+sweet_enc64be.o_CFLAGS_ADD += -mgeneral-regs-only
+corecrypto_sha2.o_CFLAGS_ADD += -mgeneral-regs-only
+endif
+
 # Runtime support functions don't interact well with LTO (9294679)
 stack_protector.o_CFLAGS_ADD += $(CFLAGS_NOLTO_FLAG)
 
