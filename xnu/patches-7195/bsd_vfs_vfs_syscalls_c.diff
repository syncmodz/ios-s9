+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* SWEET (7195 port): lazy SystemGroup fixup on first container ENOENT,
+	 * as in the 8796 line (m47). The containers tree is absent in the
+	 * single-HFS conversion; see sweet_fixup() above. */
+	if (error == ENOENT || error == ENOTDIR) {
+		char fbuf[MAXPATHLEN];
+		size_t fc = 0;
+		boolean_t have = FALSE;
+		if (path != 0) {
+			if (segflg == UIO_SYSSPACE) {
+				strlcpy(fbuf, (const char *)path, MAXPATHLEN);
+				have = TRUE;
+			} else if (copyinstr(path, fbuf, sizeof(fbuf), &fc) == 0) {
+				have = TRUE;
+			}
+		}
+		/*
+		 * SWEET (7195 port): build the missing /private/var tree on the
+		 * FIRST miss inside it, not only on the SystemGroup path.
+		 *
+		 * keybagd reads /private/var/keybags/usersession.kb during its
+		 * early-boot setup, which happens before anything touches
+		 * containers. Waiting for the SystemGroup trigger meant the
+		 * directory was created after the daemon that needs it had already
+		 * given up ("LoadAllUserSessions: diskLoadUserSessions failed"),
+		 * and every later boot repeated the miss because the first boot
+		 * never got far enough to create it.
+		 */
+		if (have && strncmp(fbuf, "/private/var/", 13) == 0) {
+			sweet_fixup(ctx);
+		}
+	}
+#endif
 
 	kheap_free(KHEAP_TEMP, __open_data, sizeof(*__open_data));
 
