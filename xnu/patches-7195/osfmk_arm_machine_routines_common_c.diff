+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET: publish the CPU count without touching max_cpus_lock. Called from
+ * ml_parse_cpu_topology() very early in boot, before the lock subsystem has
+ * initialised that mutex: ml_set_max_cpus() there panicked with
+ * "invalid mutex". Boot is single-threaded at that point, so the lock buys
+ * nothing. ml_set_max_cpus() stays idempotent for the later SweetCPU call.
+ */
+void
+ml_set_max_cpus_early(unsigned int max_cpus __unused)
+{
+	max_cpus_initialized = MAX_CPUS_SET;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
