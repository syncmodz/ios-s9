+/*
+ * Routine: bank_task_can_adopt_persona
+ * Purpose: Decides whether a bank task may take on another persona.
+ *
+ * SWEET (7195 port): transcribed from the 8796 line (bank.c:1985). Adopting
+ * the same persona is always fine; otherwise the task must have been flagged
+ * ADOPTION_ALLOWED (bank_task_alloc_init) and its persona uid must either not
+ * belong to any user (KAUTH_UID_NONE / UINT_MAX, which is how a system persona
+ * is created) or match the persona being adopted. Without this check the only
+ * gate was the flag, so a process could take on any persona at all.
+ */
+static boolean_t
+bank_task_can_adopt_persona(bank_task_t bank_merchant, struct bank_persona *persona)
+{
+	if (bank_merchant->bt_persona_id == persona->persona_id) {
+		return TRUE;
+	}
+
+	if ((bank_merchant->bt_flags & PROC_PERSONA_INFO_FLAG_ADOPTION_ALLOWED) == 0) {
+		return FALSE;
+	}
+
+	uint32_t own_uid = bank_merchant->bt_persona_uid;
+	uint32_t new_uid = persona->persona_uid;
+	return own_uid == SWEET_KAUTH_UID_NONE || own_uid == UINT_MAX || own_uid == new_uid;
 }
