+/*
+ * SWEET (7195 port): substring test on a counted name. kern_exec does not
+ * include string.h, and imgp's name is not guaranteed NUL-terminated at
+ * cn_namelen, so strstr/memmem are both out.
+ */
+static boolean_t
+sweet_name_has(const char *name, size_t len, const char *needle)
+{
+	size_t nlen = strlen(needle);
+	if (name == NULL || nlen == 0 || len < nlen) {
+		return FALSE;
+	}
+	for (size_t i = 0; i + nlen <= len; i++) {
+		if (memcmp(name + i, needle, nlen) == 0) {
+			return TRUE;
+		}
+	}
+	return FALSE;
+}
 
