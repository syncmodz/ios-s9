+		kernel_bootstrap_log("sweet_amfi_policy_register");
+		sweet_amfi_policy_register();
+	}
+	/*
+	 * SWEET (7195 port): arm the APSS watchdog as early as the kernel can.
+	 *
+	 * The hangs that cost whole sessions happened before mountroot, and the
+	 * arm in sweet_ufs_init() is after it. ml_io_map() works this early
+	 * (io_map.c falls back to the bootstrap virtual space when kernel_map is
+	 * still null, which is how sweet_spmi.c maps its registers), and the
+	 * timer interrupt is already running by the time this code executes, so
+	 * the pet in rtclock_intr() keeps it fed from here on.
+	 */
+	{
+		extern void sweet_wdt_arm(void);
+		kernel_bootstrap_log("sweet_wdt_arm");
+		sweet_wdt_arm();
+	}
+	/*
+	 * SWEET (7195 port): publish the multiuser config word.
+	 *
+	 * Nothing on this port calls host_set_multiuser_config_flags(), so the
+	 * commpage word stays 0. libdispatch's voucher_get_current_persona reads
+	 * a byte of it and tests bit 0x2 before deciding which persona the caller
+	 * is under; with the word at zero every process takes the "no persona"
+	 * branch without any syscall, which is why containermanagerd's identity
+	 * lookups come back empty and it aborts after its retries.
+	 *
+	 * Single-user device with uid 501 (mobile) as the current user: the UID
+	 * lives in kMultiUserCurrentUserMask. kIsMultiUserDevice (0x80000000)
+	 * must STAY CLEAR -- this is one user, and that bit is what
+	 * persona_proc_adopt() tests before rewriting the session login name.
+	 * The 8796 tree, which draws, leaves both at 0 and still works.
+	 */
+	{
+		extern void commpage_update_multiuser_config(uint32_t);
+		/* kMultiUserCurrentUserMask (arm/cpu_capabilities.h:78); the header
+		 * is not included in this bootstrap file. */
+		commpage_update_multiuser_config(501u & 0x7fffffffu);
+	}
