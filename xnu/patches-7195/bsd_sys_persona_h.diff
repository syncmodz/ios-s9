--- a/bsd/sys/persona.h	2026-10-31 19:09:32
+++ b/bsd/sys/persona.h	2026-11-15 02:40:39
@@ -56,6 +56,7 @@
 #define PERSONA_ID_NONE ((uid_t)-1)
 
 struct kpersona_info {
+	/* v1 fields */
 	uint32_t persona_info_version;
 
 	uid_t    persona_id; /* overlaps with UID */
@@ -66,10 +67,31 @@
 	uid_t    persona_gmuid;
 	char     persona_name[MAXLOGNAME + 1];
 
+	/* v2 fields */
+	uid_t    persona_uid;
