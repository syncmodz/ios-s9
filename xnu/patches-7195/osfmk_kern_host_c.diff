+	 * attributes"), which takes backboardd and the window server with it.
 	 */
-	commpage_update_multiuser_config(multiuser_config | kIsMultiUserDevice);
+	commpage_update_multiuser_config(multiuser_config);
 	return KERN_SUCCESS;
 #else
 	(void)host_priv;
